import "std/io";
import "std/process";
import "std/fs";
import "std/path";
import "std/string" {eq};
import "./config.zp";
import "./utils.zp";
import "std/collection";

fun extractNameFromUrl(url: String) String {
    var i: Int = string.len(url) - 1;
    while i >= 0 {
        if string.at(url, i) == '/' { break; }
        i = i - 1;
    }
    var name: String = "";
    var j: Int = i + 1;
    while j < string.len(url) {
        name = string.pushChar(name, string.at(url, j));
        j = j + 1;
    }
    if string.len(name) > 4 {
        var end: Int = string.len(name);
        if string.at(name, end - 4) == '.' && string.at(name, end - 3) == 'g' && string.at(name, end - 2) == 'i' && string.at(name, end - 1) == 't' {
            var clean: String = "";
            var k: Int = 0;
            while k < end - 4 {
                clean = string.pushChar(clean, string.at(name, k));
                k = k + 1;
            }
            return clean;
        }
    }
    return name;
}

pub fun runShellCapture(cmd: String) String {
    var tmpFile: String = ".thor_tmp_out";
    var c: String = "(" + cmd + ") > " + tmpFile;
    if process.exec(c) != 0 {
        return "";
    }
    if fs.exists(tmpFile) {
        var out: String = fs.readFile(tmpFile) or err {
            process.exec("rm -f " + tmpFile);
            return "";
        };
        process.exec("rm -f " + tmpFile);
        var l: Int = string.len(out);
        if l > 0 && string.at(out, l - 1) == '\n' {
            var trimmed: String = "";
            var i: Int = 0;
            while i < l - 1 {
                trimmed = string.pushChar(trimmed, string.at(out, i));
                i = i + 1;
            }
            return trimmed;
        }
        return out;
    }
    return "";
}



fun splitLinesKeepAll(content: String) collection.List<String> {
    var lines: collection.List<String> = new collection.List<String>();
    var current: String = "";
    var i: Int = 0;
    while i < string.len(content) {
        var c: Char = string.at(content, i);
        if c == '\n' {
            lines.push(current);
            current = "";
        } else if c != '\r' {
            current = string.pushChar(current, c);
        }
        i = i + 1;
    }
    if string.len(current) != 0 {
        lines.push(current);
    }
    return lines;
}

fun joinLines(lines: collection.List<String>) String {
    var res: String = "";
    var i: Int = 0;
    while i < lines.len() {
        res = res + lines.at(i) + "\n";
        i = i + 1;
    }
    return res;
}

// Ensures `[sectionHeader]` exists in `content` and appends `line` under
// it (creating the section at the end of the file if it wasn't there).
fun insertTableEntry(content: String, sectionHeader: String, line: String) String {
    var lines: collection.List<String> = splitLinesKeepAll(content);

    var hasSection: Bool = false;
    var i: Int = 0;
    while i < lines.len() {
        if eq(lines.at(i), sectionHeader) { hasSection = true; }
        i = i + 1;
    }

    var newLines: collection.List<String> = new collection.List<String>();
    var added: Bool = !hasSection;

    i = 0;
    while i < lines.len() {
        var l: String = lines.at(i);
        newLines.push(l);
        if eq(l, sectionHeader) && !added {
            newLines.push(line);
            added = true;
        }
        i = i + 1;
    }

    if !hasSection {
        newLines.push("");
        newLines.push(sectionHeader);
        newLines.push(line);
    }

    return joinLines(newLines);
}

fun insertDepsAndImports(content: String, name: String, gitUrl: String, tag: String, commit: String, libPath: String) String {
    var depLine: String = "\"" + name + "\" = { url = \"" + gitUrl + "\", version = \"" + tag + "\", commit = \"" + commit + "\" }";
    var importLine: String = "\"@" + name + "\" = \"" + libPath + "\"";

    var withImport: String = insertTableEntry(content, "[imports]", importLine);
    return insertTableEntry(withImport, "[dependencies]", depLine);
}

// [test-dependencies] also gets a matching [imports] entry, same as
// [dependencies] does via insertDepsAndImports. config.zp's
// processTestDependencies auto-derives this same alias for `thor test`'s
// own zapc invocation regardless, but zap-lsp is a separate binary that
// only ever reads the literal [imports] table -- it has no idea
// [test-dependencies] exists. Without a real [imports] line, every file
// importing this alias shows phantom "import path not found" /
// "Undefined identifier" errors in the editor even though `thor test`
// compiles it fine (confirmed by probing zap-lsp directly). This is safe
// for `thor build`/`thor run`: an [imports] entry only feeds zapc's
// --import-map, which zapc consults when an import actually resolves to
// that alias -- an unused entry (or one whose target doesn't exist yet)
// is inert, so this can't leak a test-only dependency into a production
// binary that never imports it.
fun insertTestDependency(content: String, name: String, gitUrl: String, tag: String, commit: String, libPath: String) String {
    var depLine: String = "\"" + name + "\" = { url = \"" + gitUrl + "\", version = \"" + tag + "\", commit = \"" + commit + "\" }";
    var importLine: String = "\"@" + name + "\" = \"" + libPath + "\"";
    var withImport: String = insertTableEntry(content, "[imports]", importLine);
    return insertTableEntry(withImport, "[test-dependencies]", depLine);
}

// projectRoot: "" operates relative to the CWD (the normal `thor add`
// case); a real path lets `thor new` add a dependency into a project
// it just scaffolded elsewhere, without needing any chdir primitive
// (Zap's std/process doesn't expose one) -- every path used here is
// just explicitly joined under projectRoot instead.
fun addDependencyInternal(projectRoot: String, gitUrl: String, asTestDep: Bool) Int {
    var name: String = extractNameFromUrl(gitUrl);
    if string.len(name) == 0 {
        io.eprintln("Invalid git URL");
        return 1;
    }

    var vendorDir: String = path.join(projectRoot, "vendor");
    fs.mkdirAll(vendorDir) or err {
        io.eprintln("Failed to create vendor directory");
        return 1;
    };
    var vendorPath: String = path.join(vendorDir, name);

    if fs.exists(vendorPath) {
        io.println("Dependency " + name + " already exists in vendor/");
    } else {
        io.println("Cloning " + gitUrl + " into " + vendorPath + "...");
        if process.exec("git clone --recursive " + utils.shellQuote(gitUrl) + " " + utils.shellQuote(vendorPath)) != 0 {
            io.eprintln("Failed to clone dependency");
            return 1;
        }
    }

    var commit: String = runShellCapture("cd " + utils.shellQuote(vendorPath) + " && git rev-parse HEAD");
    var tag: String = runShellCapture("cd " + utils.shellQuote(vendorPath) + " && git describe --tags --abbrev=0 2>/dev/null");

    if string.len(tag) == 0 {
        tag = commit;
    }

    var tomlPath: String = path.join(projectRoot, "thor.toml");
    var content: String = fs.readFile(tomlPath) or err {
        io.eprintln("Failed to read " + tomlPath);
        return 1;
    };

    var libPath: String = "./vendor/" + name + "/src/lib";
    if !fs.exists(vendorPath + "/src/lib") {
        libPath = "./vendor/" + name + "/src";
    }

    var newContent: String;
    if asTestDep {
        newContent = insertTestDependency(content, name, gitUrl, tag, commit, libPath);
    } else {
        newContent = insertDepsAndImports(content, name, gitUrl, tag, commit, libPath);
    }

    fs.writeFile(tomlPath, newContent) or err {
        io.eprintln("Failed to write to thor.toml");
        return 1;
    };

    if asTestDep {
        io.println("Added test dependency: " + name + " (" + tag + ")");
    } else {
        io.println("Added dependency: " + name + " (" + tag + ")");
    }
    return 0;
}

pub fun addDependency(gitUrl: String) Int {
    return addDependencyInternal("", gitUrl, false);
}

pub fun addTestDependency(gitUrl: String) Int {
    return addDependencyInternal("", gitUrl, true);
}

// Used by `thor new` to wire zap-test into a project it just scaffolded
// elsewhere -- projectRoot is that project's directory, not the CWD.
pub fun addTestDependencyInRoot(projectRoot: String, gitUrl: String) Int {
    return addDependencyInternal(projectRoot, gitUrl, true);
}

fun restoreDependencyList(deps: collection.List<config.Dependency>) Int {
    if deps.len() == 0 { return 0; }

    fs.mkdirAll("vendor") or err {
        io.eprintln("Failed to create vendor directory");
        return 1;
    };
    var i: Int = 0;
    while i < deps.len() {
        var dep: config.Dependency = deps.at(i);
        var vendorPath: String = path.join("vendor", dep.name);

        if !fs.exists(vendorPath) {
            io.println("Restoring dependency " + dep.name + "...");
            if process.exec("git clone --recursive " + utils.shellQuote(dep.url) + " " + utils.shellQuote(vendorPath)) != 0 {
                io.eprintln("Failed to clone " + dep.name);
                return 1;
            }
            if string.len(dep.commit) != 0 {
                process.exec("cd " + utils.shellQuote(vendorPath) + " && git checkout " + utils.shellQuote(dep.commit));
            }
            process.exec("cd " + utils.shellQuote(vendorPath) + " && git submodule update --init --recursive");
        }

        var buildScript: String = path.join(vendorPath, "build.sh");
        if fs.exists(buildScript) {
            io.println("Running build.sh for " + dep.name + "...");
            if process.exec("cd " + utils.shellQuote(vendorPath) + " && bash build.sh") != 0 {
                io.eprintln("Failed to build " + dep.name);
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

pub fun restoreAndBuildDependencies(cfg: config.ProjectConfig) Int {
    return restoreDependencyList(cfg.deps);
}

// Only called from `thor test` -- [test-dependencies] never gets
// restored (or linked) for `thor build`/`thor run`.
pub fun restoreTestDependencies(cfg: config.ProjectConfig) Int {
    return restoreDependencyList(cfg.testDeps);
}
