import "std/io";
import "std/fs";
import "std/path";
import "std/string" {eq};
import "./utils.zp";
import "./deps.zp";

pub const ZAP_TEST_URL: String = "https://github.com/zap-tooling/zap-test";

pub fun scaffoldMainSource(projectName: String) String {
    return "import \"std/io\";\n\nfun main() Int {\n    io.println(\"hello from " + projectName + "\");\n    return 0;\n}\n";
}

pub fun scaffoldThorToml(projectName: String) String {
    return "name         = \"" + projectName + "\"\nversion      = \"0.1.0\"\nout          = \"build/\"\nentry        = \"src/main.zp\"\n\n# compiler  = \"zapc\"\n# optimization = \"O0\"\n# flags     = \"\"\n\n# before_compile = \"\"\n# after_compile  = \"\"\n\n# [imports]\n# \"@utils\" = \"./src/utils\"\n";
}

pub fun scaffoldGitignore() String {
    return "build/\nvendor/\n";
}

pub fun scaffoldExampleTest() String {
    return "import \"@zap-test/test\" {TestContext};\n\n" +
        "@test\n" +
        "pub fun testExample(t: TestContext) Void {\n" +
        "    t.assertEqual(2 + 2, 4, \"addition works\");\n" +
        "}\n";
}

pub fun createProject(projectName: String) Int {
    if !utils.isValidProjectName(projectName) {
        io.eprintln("invalid project name: " + projectName);
        return 1;
    }
    if utils.startsWithDash(projectName) {
        io.eprintln("project name cannot start with '-'");
        return 1;
    }

    var root: String = projectName;
    var srcDir: String = path.join(root, "src");
    var testDir: String = path.join(root, "test");
    var thorTomlPath: String = path.join(root, "thor.toml");
    var gitignorePath: String = path.join(root, ".gitignore");
    var mainPath: String = path.join(srcDir, "main.zp");
    var exampleTestPath: String = path.join(testDir, "example_test.zp");

    if fs.exists(root) {
        io.eprintln("target already exists: " + root);
        return 1;
    }

    fs.mkdirAll(srcDir) or err {
        io.eprintln("failed to create project directories");
        return 1;
    };

    fs.mkdirAll(testDir) or err {
        io.eprintln("failed to create project directories");
        return 1;
    };

    fs.writeFile(thorTomlPath, scaffoldThorToml(projectName)) or err {
        io.eprintln("failed to write " + thorTomlPath);
        return 1;
    };

    fs.writeFile(gitignorePath, scaffoldGitignore()) or err {
        io.eprintln("failed to write " + gitignorePath);
        return 1;
    };

    fs.writeFile(mainPath, scaffoldMainSource(projectName)) or err {
        io.eprintln("failed to write " + mainPath);
        return 1;
    };

    fs.writeFile(exampleTestPath, scaffoldExampleTest()) or err {
        io.eprintln("failed to write " + exampleTestPath);
        return 1;
    };

    // Non-fatal: the project is still validly scaffolded without it (no
    // network, e.g.) -- `thor add <url> --test` can add it later.
    if deps.addTestDependencyInRoot(root, ZAP_TEST_URL) != 0 {
        io.eprintln("warning: failed to add zap-test as a test dependency (offline?) -- run `thor add " + ZAP_TEST_URL + " --test` inside " + root + " later");
    }

    io.println("created project: " + root);
    return 0;
}
